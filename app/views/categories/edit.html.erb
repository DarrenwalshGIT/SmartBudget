
<%# Allows users to update an existing category. %>

<div class="row justify-content-center">
  <div class="col-12 col-md-9 col-lg-7">
    <div class="mb-4">
      <h1 class="fw-bold mb-1">Edit Category</h1>
      <p class="text-muted">
        Update the name or description of this category.
      </p>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <%= form_with model: @category do |form| %>
          <%# Display validation errors without losing submitted changes. %>
          <% if @category.errors.any? %>
            <div class="alert alert-danger" role="alert">
              <h2 class="h6">Please correct the following errors:</h2>
              <ul class="mb-0">
                <% @category.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :name, "Category Name",
                           class: "form-label fw-semibold" %>
            <%= form.text_field :name, class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= form.label :description,
                           class: "form-label fw-semibold" %>
            <%= form.text_area :description,
                               class: "form-control",
                               rows: 4 %>
            <div class="form-text">
              A description is optional.
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2">
            <%= form.submit "Save Changes", class: "btn btn-primary" %>
            <%= link_to "Cancel", category_path(@category),
                        class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
