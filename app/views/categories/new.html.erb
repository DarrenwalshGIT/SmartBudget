
<%# Allow users to enter a new spending category. %>

<h1>New Category</h1>

<%= form_with model: @category do |form| %>
  <%# Display validation errors if submitted information is invalid. %>
  <% if @category.errors.any? %>
    <div>
      <h2>Please correct the following errors:</h2>
      <ul>
        <% @category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Category name is required by the Category model. %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <%# Description is optional and can contain longer text. %>
  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <%# Submit the form to create the database record. %>
  <div>
    <%= form.submit "Create Category" %>
  </div>
<% end %>

<%= link_to "Back to Categories", categories_path %>
