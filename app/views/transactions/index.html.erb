
<%# Displays recorded income and expenses in a responsive table. %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="fw-bold mb-1">Transactions</h1>
    <p class="text-muted mb-0">Manage your income and expenses.</p>
  </div>

  <%= link_to "Add Transaction", new_transaction_path,
              class: "btn btn-primary" %>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <% if @transactions.empty? %>
      <%# Display a helpful message when no transactions exist. %>
      <div class="text-center py-5">
        <h2 class="h5">No transactions recorded yet</h2>
        <p class="text-muted">
          Add your first transaction to start tracking your finances.
        </p>
        <%= link_to "Add Transaction", new_transaction_path,
                    class: "btn btn-primary" %>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Description</th>
              <th scope="col">Category</th>
              <th scope="col">Type</th>
              <th scope="col" class="text-end">Amount</th>
            </tr>
          </thead>

          <tbody>
            <% @transactions.each do |transaction| %>
              <tr>
                <td><%= transaction.transaction_date.strftime("%d %b %Y") %></td>
                <td class="fw-medium"><%= transaction.description %></td>
                <td><%= transaction.category.name %></td>
                <td>
                  <%# Use different colours to distinguish income and expenses. %>
                  <% if transaction.transaction_type == "income" %>
                    <span class="badge text-bg-success">Income</span>
                  <% else %>
                    <span class="badge text-bg-danger">Expense</span>
                  <% end %>
                </td>
                <td class="text-end fw-semibold">
                  <%= number_to_currency(transaction.amount, unit: "€") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-4">
  <%= link_to "Manage Categories", categories_path,
              class: "btn btn-outline-secondary" %>
</div>
