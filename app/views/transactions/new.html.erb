
<%# Form for recording a new income or expense transaction. %>

<div class="row justify-content-center">
  <div class="col-12 col-md-9 col-lg-7">
    <div class="mb-4">
      <h1 class="fw-bold mb-1">Add Transaction</h1>
      <p class="text-muted">
        Record your income and expenses to keep your budget up to date.
      </p>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <%= form_with model: @transaction do |form| %>
          <%# Display validation errors without losing submitted details. %>
          <% if @transaction.errors.any? %>
            <div class="alert alert-danger" role="alert">
              <h2 class="h6">Please correct the following errors:</h2>
              <ul class="mb-0">
                <% @transaction.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :description, class: "form-label fw-semibold" %>
            <%= form.text_field :description,
                                class: "form-control",
                                placeholder: "e.g. Weekly groceries" %>
          </div>

          <div class="mb-3">
            <%= form.label :amount, "Amount (€)",
                           class: "form-label fw-semibold" %>
            <%= form.number_field :amount,
                                  class: "form-control",
                                  step: "0.01",
                                  min: "0.01",
                                  placeholder: "0.00" %>
          </div>

          <div class="mb-3">
            <%= form.label :transaction_type, "Transaction Type",
                           class: "form-label fw-semibold" %>
            <%= form.select :transaction_type,
                            [["Expense", "expense"], ["Income", "income"]],
                            { prompt: "Select a transaction type" },
                            { class: "form-select" } %>
          </div>

          <div class="mb-3">
            <%= form.label :transaction_date, "Date",
                           class: "form-label fw-semibold" %>
            <%= form.date_field :transaction_date,
                                class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= form.label :category_id, "Category",
                           class: "form-label fw-semibold" %>
            <%= form.collection_select :category_id,
                                       @categories,
                                       :id,
                                       :name,
                                       { prompt: "Select a category" },
                                       { class: "form-select" } %>
            <div class="form-text">
              Transactions must be assigned to an existing category.
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2">
            <%= form.submit "Add Transaction", class: "btn btn-primary" %>
            <%= link_to "Cancel", transactions_path,
                        class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
